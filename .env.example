# ===============================================
# Настройки Telegram
# ===============================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TARGET_CHAT_ID=-1001234567890

# ===============================================
# Redis для мгновенной дедупликации
# ===============================================
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_HOURS=24

# ===============================================
# Параметры мониторинга и свежести (Zero Latency)
# ===============================================
# Максимальный возраст объявления в секундах (3 минуты = 180 сек, 5 минут = 300 сек)
MAX_ITEM_AGE_SECONDS=21600

# Интервал опроса каждой площадки в секундах (при наличии пула прокси можно ставить 1.5 - 3.0 сек)
AVITO_POLL_INTERVAL_SEC=3.0
YOULA_POLL_INTERVAL_SEC=3.0

# Локация поиска (Москва = 107620 на Авито, город по умолчанию на Юле)
AVITO_LOCATION_ID=637640
YOULA_CITY_ID=576d06124994ee94589d8194

# ===============================================
# Прокси (HTTP / SOCKS5)
# Формат: http://user:pass@ip:port или socks5://user:pass@ip:port (по одному на строку в файле)
# ===============================================
PROXIES_FILE=proxies.txt
SEMANTIC_DEDUP_WINDOW_HOURS=6
