{
  "$schema": "https://design-tokens.org/schema.json",
  "motion": {
    "morphing": {
      "$description": "Shape morphing and transformation tokens for path interpolation",

      "speed": {
        "$description": "Morph transition durations",
        "instant": {
          "$value": "100ms",
          "$type": "duration",
          "$description": "Instant morph"
        },
        "fast": {
          "$value": "300ms",
          "$type": "duration",
          "$description": "Quick morph transition"
        },
        "normal": {
          "$value": "600ms",
          "$type": "duration",
          "$description": "Standard morph speed"
        },
        "slow": {
          "$value": "1200ms",
          "$type": "duration",
          "$description": "Slow, dramatic morph"
        },
        "deliberate": {
          "$value": "2000ms",
          "$type": "duration",
          "$description": "Very slow, deliberate transformation"
        }
      },

      "easing": {
        "$description": "Morph-specific easing curves",
        "smooth": {
          "$value": [0.4, 0, 0.2, 1],
          "$type": "cubicBezier",
          "$description": "Smooth organic morph"
        },
        "elastic": {
          "$value": [0.68, -0.55, 0.265, 1.55],
          "$type": "cubicBezier",
          "$description": "Elastic overshoot morph"
        },
        "bounce": {
          "$value": [0.34, 1.56, 0.64, 1],
          "$type": "cubicBezier",
          "$description": "Bouncy morph ending"
        }
      },

      "interpolation": {
        "$description": "Path interpolation methods",
        "linear": {
          "$value": "linear",
          "$type": "string",
          "$description": "Linear point-to-point interpolation"
        },
        "bezier": {
          "$value": "bezier",
          "$type": "string",
          "$description": "Bezier curve interpolation"
        },
        "spring": {
          "$value": "spring",
          "$type": "string",
          "$description": "Spring physics interpolation"
        }
      },

      "path-matching": {
        "$description": "How to match points between shapes",
        "closest": {
          "$value": "closest",
          "$type": "string",
          "$description": "Match to nearest point"
        },
        "angular": {
          "$value": "angular",
          "$type": "string",
          "$description": "Match by angular position"
        },
        "indexed": {
          "$value": "indexed",
          "$type": "string",
          "$description": "Match by point index"
        }
      },

      "subdivision": {
        "$description": "Path subdivision for smooth morphs",
        "low": {
          "$value": "10",
          "$type": "number",
          "$description": "Minimal subdivision"
        },
        "medium": {
          "$value": "50",
          "$type": "number",
          "$description": "Standard subdivision"
        },
        "high": {
          "$value": "100",
          "$type": "number",
          "$description": "High detail subdivision"
        },
        "ultra": {
          "$value": "200",
          "$type": "number",
          "$description": "Ultra-smooth subdivision"
        }
      },

      "blob": {
        "$description": "Blob/organic shape morph parameters",
        "complexity": {
          "simple": {
            "$value": "3",
            "$type": "number",
            "$description": "Simple blob (3 control points)"
          },
          "normal": {
            "$value": "6",
            "$type": "number",
            "$description": "Standard blob complexity"
          },
          "complex": {
            "$value": "12",
            "$type": "number",
            "$description": "Complex organic blob"
          }
        },
        "amplitude": {
          "subtle": {
            "$value": "0.1",
            "$type": "number",
            "$description": "Subtle shape variation"
          },
          "moderate": {
            "$value": "0.3",
            "$type": "number",
            "$description": "Moderate shape variation"
          },
          "dramatic": {
            "$value": "0.6",
            "$type": "number",
            "$description": "Dramatic shape variation"
          }
        },
        "speed": {
          "slow": {
            "$value": "8000ms",
            "$type": "duration",
            "$description": "Slow blob animation"
          },
          "normal": {
            "$value": "4000ms",
            "$type": "duration",
            "$description": "Standard blob speed"
          },
          "fast": {
            "$value": "2000ms",
            "$type": "duration",
            "$description": "Fast blob animation"
          }
        }
      },

      "icon-morph": {
        "$description": "Icon-to-icon morph settings",
        "transition": {
          "quick": {
            "$value": "200ms",
            "$type": "duration",
            "$description": "Quick icon transition"
          },
          "standard": {
            "$value": "400ms",
            "$type": "duration",
            "$description": "Standard icon morph"
          },
          "smooth": {
            "$value": "600ms",
            "$type": "duration",
            "$description": "Smooth icon transition"
          }
        },
        "rotation": {
          "none": {
            "$value": "0deg",
            "$type": "dimension",
            "$description": "No rotation during morph"
          },
          "quarter": {
            "$value": "90deg",
            "$type": "dimension",
            "$description": "Quarter turn during morph"
          },
          "half": {
            "$value": "180deg",
            "$type": "dimension",
            "$description": "Half turn during morph"
          },
          "full": {
            "$value": "360deg",
            "$type": "dimension",
            "$description": "Full rotation during morph"
          }
        }
      },

      "liquid": {
        "$description": "Liquid/fluid morph effects",
        "tension": {
          "low": {
            "$value": "0.2",
            "$type": "number",
            "$description": "Low surface tension (more fluid)"
          },
          "medium": {
            "$value": "0.5",
            "$type": "number",
            "$description": "Medium surface tension"
          },
          "high": {
            "$value": "0.8",
            "$type": "number",
            "$description": "High surface tension (more cohesive)"
          }
        },
        "viscosity": {
          "water": {
            "$value": "0.1",
            "$type": "number",
            "$description": "Water-like viscosity"
          },
          "honey": {
            "$value": "0.5",
            "$type": "number",
            "$description": "Honey-like viscosity"
          },
          "gel": {
            "$value": "0.8",
            "$type": "number",
            "$description": "Gel-like viscosity"
          }
        }
      },

      "text-morph": {
        "$description": "Text/glyph morphing parameters",
        "per-character": {
          "$value": "50ms",
          "$type": "duration",
          "$description": "Delay between characters"
        },
        "overlap": {
          "$value": "0.3",
          "$type": "number",
          "$description": "Character animation overlap"
        }
      }
    }
  }
}
