{
  "android": {
    "$description": "Android platform-specific motion tokens for Material 3, Jetpack Compose, and legacy APIs",

    "m3-easing": {
      "$description": "Material 3 canonical easing curves for Android",

      "emphasized": {
        "$value": [0.2, 0, 0, 1],
        "$type": "cubicBezier",
        "$description": "FastOutSlowInInterpolator - primary M3 easing"
      },

      "emphasized-decelerate": {
        "$value": [0.05, 0.7, 0.1, 1],
        "$type": "cubicBezier",
        "$description": "M3 entrance easing - DecelerateInterpolator replacement"
      },

      "emphasized-accelerate": {
        "$value": [0.3, 0, 0.8, 0.15],
        "$type": "cubicBezier",
        "$description": "M3 exit easing - AccelerateInterpolator replacement"
      },

      "standard": {
        "$value": [0.2, 0, 0, 1],
        "$type": "cubicBezier",
        "$description": "M3 standard motion, same as emphasized"
      },

      "standard-decelerate": {
        "$value": [0, 0, 0, 1],
        "$type": "cubicBezier",
        "$description": "Standard decelerate for entering elements"
      },

      "standard-accelerate": {
        "$value": [0.3, 0, 1, 1],
        "$type": "cubicBezier",
        "$description": "Standard accelerate for exiting elements"
      }
    },

    "legacy-interpolator": {
      "$description": "Legacy Android interpolators for backward compatibility",

      "accelerate": {
        "$value": [0.4, 0, 1, 1],
        "$type": "cubicBezier",
        "$description": "AccelerateInterpolator - exits"
      },

      "decelerate": {
        "$value": [0, 0, 0.2, 1],
        "$type": "cubicBezier",
        "$description": "DecelerateInterpolator - entrances"
      },

      "accelerate-decelerate": {
        "$value": [0.42, 0, 0.58, 1],
        "$type": "cubicBezier",
        "$description": "AccelerateDecelerateInterpolator"
      },

      "fast-out-slow-in": {
        "$value": [0.4, 0, 0.2, 1],
        "$type": "cubicBezier",
        "$description": "FastOutSlowInInterpolator - M2 standard"
      },

      "fast-out-linear-in": {
        "$value": [0.4, 0, 1, 1],
        "$type": "cubicBezier",
        "$description": "FastOutLinearInInterpolator - exits"
      },

      "linear-out-slow-in": {
        "$value": [0, 0, 0.2, 1],
        "$type": "cubicBezier",
        "$description": "LinearOutSlowInInterpolator - entrances"
      }
    },

    "compose-spring": {
      "$description": "Jetpack Compose spring specifications",

      "default": {
        "$value": {
          "dampingRatio": 1.0,
          "stiffness": 500
        },
        "$type": "object",
        "$description": "Spring.DampingRatioNoBouncy + Spring.StiffnessMedium"
      },

      "low-bouncy": {
        "$value": {
          "dampingRatio": 0.75,
          "stiffness": 500
        },
        "$type": "object",
        "$description": "Spring.DampingRatioLowBouncy - subtle bounce"
      },

      "medium-bouncy": {
        "$value": {
          "dampingRatio": 0.5,
          "stiffness": 500
        },
        "$type": "object",
        "$description": "Spring.DampingRatioMediumBouncy - visible bounce"
      },

      "high-bouncy": {
        "$value": {
          "dampingRatio": 0.2,
          "stiffness": 500
        },
        "$type": "object",
        "$description": "Spring.DampingRatioHighBouncy - playful bounce"
      },

      "low-stiffness": {
        "$value": {
          "dampingRatio": 1.0,
          "stiffness": 200
        },
        "$type": "object",
        "$description": "Spring.StiffnessLow - slower, gentle"
      },

      "medium-low-stiffness": {
        "$value": {
          "dampingRatio": 1.0,
          "stiffness": 400
        },
        "$type": "object",
        "$description": "Spring.StiffnessMediumLow - moderate"
      },

      "medium-stiffness": {
        "$value": {
          "dampingRatio": 1.0,
          "stiffness": 500
        },
        "$type": "object",
        "$description": "Spring.StiffnessMedium - standard"
      },

      "high-stiffness": {
        "$value": {
          "dampingRatio": 1.0,
          "stiffness": 800
        },
        "$type": "object",
        "$description": "Spring.StiffnessHigh - snappy"
      },

      "very-high-stiffness": {
        "$value": {
          "dampingRatio": 1.0,
          "stiffness": 10000
        },
        "$type": "object",
        "$description": "Spring.StiffnessVeryHigh - instant"
      }
    },

