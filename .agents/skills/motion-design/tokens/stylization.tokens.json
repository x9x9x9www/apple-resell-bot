{
  "$schema": "https://designtokens.org/schemas/draft-2/schema.json",
  "$description": "Stylization tokens for artistic motion presets including vintage, minimalist, brutalist, and organic styles.",

  "motion": {
    "stylization": {
      "$description": "Artistic motion style tokens",

      "vintage": {
        "$description": "Retro/vintage motion style parameters",

        "film-grain": {
          "$value": 0.15,
          "$type": "number",
          "$description": "Film grain opacity. Subtle texture."
        },
        "flicker-intensity": {
          "$value": 0.05,
          "$type": "number",
          "$description": "Subtle brightness flicker. Old projector feel."
        },
        "frame-rate": {
          "$value": 12,
          "$type": "number",
          "$description": "Low frame rate. Silent film era (12fps)."
        },
        "sepia": {
          "$value": 0.6,
          "$type": "number",
          "$description": "Sepia filter intensity. Aged photo look."
        },
        "vignette": {
          "$value": 0.3,
          "$type": "number",
          "$description": "Edge darkening. Old camera vignette."
        },
        "speed-variation": {
          "$value": 0.1,
          "$type": "number",
          "$description": "Playback speed variance. Hand-cranked feel."
        }
      },

      "minimalist": {
        "$description": "Clean, minimal motion style parameters",

        "duration-multiplier": {
          "$value": 1.2,
          "$type": "number",
          "$description": "Slightly slower animations. Deliberate feel."
        },
        "easing": {
          "$value": [0.2, 0, 0, 1],
          "$type": "cubicBezier",
          "$description": "M3 standard easing. Smooth, refined."
        },
        "delay-between": {
          "$value": "100ms",
          "$type": "duration",
          "$description": "Spacing between sequential animations."
        },
        "overshoot": {
          "$value": 0,
          "$type": "number",
          "$description": "No overshoot. Clean, precise endings."
        },
        "motion-blur": {
          "$value": 0,
          "$type": "number",
          "$description": "No motion blur. Crisp edges."
        }
      },

      "brutalist": {
        "$description": "Bold, aggressive motion style parameters",

        "speed-multiplier": {
          "$value": 0.5,
          "$type": "number",
          "$description": "Fast, abrupt animations."
        },
        "easing": {
          "$value": [0, 0, 1, 1],
          "$type": "cubicBezier",
          "$description": "Linear easing. No softening."
        },
        "step-count": {
          "$value": 4,
          "$type": "number",
          "$description": "Stepped animation frames. Jarring."
        },
        "overshoot": {
          "$value": 0.3,
          "$type": "number",
          "$description": "Aggressive overshoot. Bold snap-back."
        },
        "contrast": {
          "$value": 1.5,
          "$type": "number",
          "$description": "High contrast. Bold visual impact."
        },
        "shake-intensity": {
          "$value": 5,
          "$type": "number",
          "$description": "Screen shake on impact (pixels)."
        }
      },

      "organic": {
        "$description": "Natural, flowing motion style parameters",

        "noise-amplitude": {
          "$value": 3,
          "$type": "number",
          "$description": "Subtle position noise (pixels). Natural wobble."
        },
        "noise-frequency": {
          "$value": 0.5,
          "$type": "number",
          "$description": "Noise frequency. Slow, gentle variation."
        },
        "easing": {
          "$value": [0.4, 0, 0.2, 1],
          "$type": "cubicBezier",
          "$description": "Soft easing. Natural acceleration."
        },
        "duration-variance": {
          "$value": 0.15,
          "$type": "number",
          "$description": "Duration randomness (+/- 15%). Organic timing."
        },
        "rotation-wobble": {
          "$value": 2,
          "$type": "number",
          "$description": "Subtle rotation noise (degrees)."
        }
      },

      "playful": {
        "$description": "Fun, energetic motion style parameters",

        "bounce-overshoot": {
          "$value": 0.2,
          "$type": "number",
          "$description": "Bouncy overshoot. Springy endings."
        },
        "squash-stretch": {
          "$value": 0.15,
          "$type": "number",
          "$description": "Deformation amount. Cartoony physics."
        },
        "speed-multiplier": {
          "$value": 0.8,
          "$type": "number",
          "$description": "Slightly faster. Energetic pace."
        },
        "spring-stiffness": {
          "$value": 300,
          "$type": "number",
          "$description": "Bouncy spring. Playful oscillation."
        },
        "spring-damping": {
          "$value": 12,
          "$type": "number",
          "$description": "Low damping. More bounces."
        }
      },

      "elegant": {
        "$description": "Sophisticated, refined motion style parameters",

        "duration-multiplier": {
          "$value": 1.5,
          "$type": "number",
          "$description": "Slower animations. Graceful pace."
        },
        "easing": {
          "$value": [0.25, 0.1, 0.25, 1],
          "$type": "cubicBezier",
          "$description": "Custom smooth easing. Refined feel."
        },
        "stagger-delay": {
          "$value": "80ms",
          "$type": "duration",
          "$description": "Orchestrated stagger. Choreographed."
        },
        "blur-entrance": {
          "$value": 4,
          "$type": "number",
          "$description": "Subtle blur on entrance (pixels)."
        },
        "opacity-start": {
          "$value": 0.7,
          "$type": "number",
          "$description": "Fade from 70%. Gentle reveal."
        }
      },

      "glitch": {
        "$description": "Digital glitch/distortion style parameters",

        "offset-x": {
          "$value": 10,
          "$type": "number",
          "$description": "Horizontal displacement (pixels)."
        },
        "offset-y": {
          "$value": 5,
          "$type": "number",
          "$description": "Vertical displacement (pixels)."
        },
        "slice-count": {
          "$value": 5,
          "$type": "number",
          "$description": "Number of horizontal slices."
        },
        "chromatic-offset": {
          "$value": 3,
          "$type": "number",
          "$description": "RGB channel separation (pixels)."
        },
        "duration": {
          "$value": "100ms",
          "$type": "duration",
          "$description": "Glitch effect duration."
        },
        "frequency": {
          "$value": 3,
          "$type": "number",
          "$description": "Glitches per second."
        }
      },

      "retro-game": {
        "$description": "8-bit/16-bit game style parameters",

        "step-count": {
          "$value": 8,
          "$type": "number",
          "$description": "Animation steps. Choppy sprite feel."
        },
        "pixel-size": {
          "$value": 4,
          "$type": "number",
          "$description": "Pixel art scale factor."
        },
        "color-depth": {
          "$value": 16,
          "$type": "number",
          "$description": "Color palette limit."
        },
        "screen-shake": {
          "$value": 8,
          "$type": "number",
          "$description": "Impact shake intensity (pixels)."
        },
        "flash-duration": {
          "$value": "50ms",
          "$type": "duration",
          "$description": "Hit flash duration."
        }
      },

      "cinematic": {
        "$description": "Film/movie style motion parameters",

        "motion-blur": {
          "$value": 0.5,
          "$type": "number",
          "$description": "180-degree shutter motion blur."
        },
        "frame-rate": {
          "$value": 24,
          "$type": "number",
          "$description": "Film standard frame rate."
        },
        "letterbox-ratio": {
          "$value": 2.35,
          "$type": "number",
          "$description": "Cinemascope aspect ratio."
        },
        "dolly-speed": {
          "$value": 0.02,
          "$type": "number",
          "$description": "Slow camera dolly. Dramatic reveal."
        },
        "fade-duration": {
          "$value": "1500ms",
          "$type": "duration",
          "$description": "Long fade transitions."
        }
      }
    }
  }
}
